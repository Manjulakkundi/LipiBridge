# LipiBridge - Optional Environment Configuration
# Copy this file to .env if you wish to override local runtime defaults.
# Note: LipiBridge runs out-of-the-box on CPU without requiring paid API keys.

# Ensure UTF-8 console output on Windows terminals
PYTHONIOENCODING=utf-8

# Streamlit server configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=false
